# Enterprise Banking Platform — Environment Template
# Copy this file to .env and fill in real values before running locally.

# PostgreSQL
POSTGRES_USER=banking
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=banking

# Service databases
AUTH_DB_NAME=auth_service
CUSTOMER_DB_NAME=customer_service
ACCOUNT_DB_NAME=account_service
TRANSACTION_DB_NAME=transaction_service
PAYMENT_DB_NAME=payment_service
NOTIFICATION_DB_NAME=notification_service
FRAUD_DB_NAME=fraud_service

# JWT
JWT_SECRET=change-me-to-a-256-bit-secret-key-here-change-me-please
JWT_EXPIRATION_MS=86400000

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# AWS (Terraform)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
